# Copy this file to .env and fill in your actual API keys

# Example for keys
NANOGPT_API_KEY=your_key_here


MINIMAX_API_KEY=your_key_here

# GigaChat credentials (only needed if you configure GigaChat models)
# GIGACHAT_API_KEY=your_base64_encoded_key
# GIGACHAT_SCOPE=GIGACHAT_API_CORP
# GIGACHAT_CLIENT_CERT=path/to/cert.pem
# GIGACHAT_CLIENT_KEY=path/to/key.pem

# Strongly recommended for every shared/non-loopback deployment. Protects config,
# log/trace, routing, key, cache/catalog, quota, and profiling admin APIs.
# YALLMP_ADMIN_PASSWORD=your_admin_password

# Optional PostgreSQL log database settings
# YALLMP_POSTGRES_DSN=postgres://yallmp:REDACTED@localhost:5432/yallmp_logs?sslmode=disable
# YALLMP_POSTGRES_PASSWORD=your_postgres_password
